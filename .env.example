# Discord (Developer Portal: Bot tab -> token; General Information -> Application ID)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Your test server. Only used by `npm run register -- --guild` (instant, server-only command copies)
DEV_GUILD_ID=

# Riot API key (dev keys expire every 24h; apply for a personal key for the long-running bot)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# SQLite file
DB_PATH=./data/leaguebot.db

# Seconds between poll ticks
POLL_INTERVAL_SEC=120

# How often (seconds) to re-check rank for players with no new games (catches dodges/decay)
RANK_REFRESH_SEC=900

# Queues to log: 420 = Ranked Solo/Duo, 440 = Ranked Flex
TRACKED_QUEUES=420,440

# Give up waiting for league-v4 to reflect a game after this many seconds and post with LP unknown
LP_SETTLE_TIMEOUT_SEC=600

# Default timezone for new guilds (digest runs at local midnight)
DEFAULT_TZ=Europe/Ljubljana

# Set to 1 to also render every resolved game to the terminal + previews/ (debugging)
PREVIEW_GAMES=0
# Where previews are written (demo, PREVIEW_GAMES=1)
PREVIEW_DIR=./previews
